# ==============================
# 🔐 ITS Open API
# ==============================
ITS_API_KEY=f1872d62339d4c3696eea5f9bee57ae6

# CCTV 요청 기본 설정
ITS_TYPE=its          # ex: its / ex (고속도로)
ITS_CCTV_TYPE=4       # 1: HLS / 2: mp4 / 3: 정지영상 / 4,5: HTTPS

# 서울 영역 (필요하면 변경)
ITS_MIN_X=126.7
ITS_MAX_X=127.3
ITS_MIN_Y=37.3
ITS_MAX_Y=37.8

ITS_RESPONSE_TYPE=json


# ==============================
# 🎥 Streaming Server 설정
# ==============================
RTSP_BASE=rtsp://localhost:8554
HLS_BASE=http://localhost:8888


# ==============================
# ⚙️ FFmpeg 옵션 (선택)
# ==============================
FFMPEG_RTSP_TRANSPORT=tcp
FFMPEG_LOGLEVEL=info


# ==============================
# 📂 파일 경로
# ==============================
CCTV_JSON_PATH=cctv_sources.json


# ==============================
# 🧪 Debug 옵션
# ==============================
DEBUG=true